{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "at-rule-no-unknown": [
      true,
      { "ignoreAtRules": ["theme", "source", "utility", "variant", "custom-variant", "plugin", "config", "apply", "reference"] }
    ],
    "import-notation": "string",
    "custom-property-empty-line-before": null
  }
}
