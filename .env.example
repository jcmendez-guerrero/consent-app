# Copia este fichero a .env para desarrollo local. NUNCA rellenar estos valores
# en la configuración real del App Service (ahí solo van SQL_SERVER y SQL_DATABASE,
# sin usuario/contraseña, porque en Azure se usa la Managed Identity del propio
# App Service).

SQL_SERVER=azusqlsappconsentnp01.database.windows.net
SQL_DATABASE=azu-sql-consent-app-01

# Modo por defecto (recomendado): deja SQL_AUTH_MODE sin definir y haz `az login`
# con una cuenta que tenga acceso a la base de datos — se usará Managed Identity /
# DefaultAzureCredential igual que en producción, sin contraseñas locales.

# Modo alternativo, solo si tu cuenta de Azure AD no tiene acceso a la base de
# datos de pruebas y te han creado un login SQL aparte:
# SQL_AUTH_MODE=sql
# SQL_USER=
# SQL_PASSWORD=

# Azure Blob Storage (US6 – subida manual de consentimientos)
# Client ID de la managed identity umi-blob-app-consent-01
MANAGED_IDENTITY_CLIENT_ID=
BLOB_CONTAINER_NAME=consentimientos
